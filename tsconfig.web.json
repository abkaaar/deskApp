{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["app/index.d.ts", "app/**/*", "lib/**/*", "lib/preload/*.d.ts", "resources/**/*"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild/web",
    "types": ["electron-vite/node"],
    "paths": {
      "@/*": ["./*"]
    }
  }
}
